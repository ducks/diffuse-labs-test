{
  "terraform": {
    "required_version": "= 1.15.9",
    "required_providers": {
      "kubernetes": {
        "source": "hashicorp/kubernetes",
        "version": "3.2.1"
      }
    }
  },
  "provider": {
    "kubernetes": {
      "config_path": "${var.kubeconfig_path}"
    }
  },
  "variable": {
    "namespace": {
      "type": "string"
    },
    "kubeconfig_path": {
      "type": "string"
    },
    "credential_secret_name": {
      "type": "string",
      "default": "runtime-credentials"
    },
    "api_node_port": {
      "type": "number"
    }
  }
}
